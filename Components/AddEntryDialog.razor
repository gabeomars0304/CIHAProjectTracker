@inject IDialogService DialogService
<MudDialog>
    <DialogContent>
        <MudStack>
            <MudTextField Label="@Label" @bind-Value="title" Variant="Variant.Outlined"
                          Immediate="true" AutoFocus="true" OnKeyDown="KeyDown" />
            <MudDatePicker Label="Start Date" @bind-Date="startDate" Editable="true"
                           Variant="Variant.Outlined" />

            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            @if (ShowTags)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Label"
                        OnClick="AddTag">Tags</MudButton>
            @foreach (var tag in tags)
            {
                <MudChip T="ItemTag" Text="@tag.Name" Size="Size.Small"
                         Color="@TagColors.For(tag)"
                         OnClose="() => tags.Remove(tag)" />
            }
            </MudStack>
            }
            <MudSpacer />
            @if (ShowGlobalTracking)
            {
                <MudTooltip Text="@(globalTrackingOn ? "Globally tracked" : "Not globally tracked")">
                <MudToggleIconButton @bind-Toggled="globalTrackingOn"
                                 Icon="@Icons.Material.Outlined.Radar"
                                 Color="@Color.Error"
                                 ToggledIcon="@Icons.Material.Filled.Radar"
                                 ToggledColor="@Color.Success" />
                </MudTooltip>
            }
        </MudStack>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton OnClick="Submit" Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@string.IsNullOrWhiteSpace(title)">Add</MudButton>
    </DialogActions>
</MudDialog>

@code {
    public sealed record EntryResult(string Title, DateTime? StartDate, List<ItemTag> Tags, bool GlobalTracking);

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string Label { get; set; } = "Title";
    [Parameter] public List<ItemTag> KnownTags { get; set; } = [];
    [Parameter] public bool ShowTags { get; set; }
    [Parameter] public bool ShowGlobalTracking { get; set; }

    private string? title;
    private DateTime? startDate = DateTime.Today;
    private bool globalTrackingOn;
    private List<ItemTag> tags = [];
    private List<ItemTag> localKnown = [];

    protected override void OnInitialized() => localKnown = [.. KnownTags];

    private void KeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter")
            Submit();
    }

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(title)) return;
        MudDialog.Close(DialogResult.Ok(new EntryResult(title.Trim(), startDate, tags, globalTrackingOn)));
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task AddTag()
    {
        var parameters = new DialogParameters<AddTagDialog>
        {
            { x => x.ExistingTags, localKnown },
            { x => x.InitiallySelected, tags }
        };

        var dialog = await DialogService.ShowAsync<AddTagDialog>("Tags", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: AddTagDialog.TagPickerResult r })
        {
            localKnown.AddRange(r.Created);   // so a second open still sees them
            tags = r.Selected;
        }
    }
}