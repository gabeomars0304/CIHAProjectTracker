@page "/"
@rendermode InteractiveServer

<PageTitle>CIHA Item Tracker</PageTitle>

<h3>CIHA Item Tracker</h3>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudTextField Label="Item Title" @bind-Value="newItem" Variant="Variant.Outlined" Immediate="true" OnKeyDown="ProjKeyDown" />
    <MudDatePicker Label="Start Date" @bind-Date="IstartDate" Editable="true" />
    <MudButton OnClick="AddItem" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary">Add Item</MudButton>
</MudStack>

<MudTable T="TableRow" Items="@BuildRows().ToList()" Dense="true" Hover="true" Breakpoint="Breakpoint.None"
          RowClass="@null" RowStyleFunc="RowStyle">
    <HeaderContent>
        <MudTh Style="min-width:380px">Title</MudTh>
        <MudTh>Start Date</MudTh>
        <MudTh>End Date</MudTh>
        <MudTh>Progress</MudTh>
        <MudTh></MudTh>
    </HeaderContent>

    <RowTemplate Context="row">
        @if (row.Kind == RowKind.Item)
        {
            var item = row.Root;
            <MudTd>
                <div class="d-flex align-center">
                    <MudIconButton Icon="@ExpandIcon(item)" Size="Size.Small" OnClick="() => Toggle(item)" />
                    <MudCheckBox @bind-Value="item.IsCompleted" @bind-Value:after="() => ItemChecked(item)" Color="Color.Primary" />
                    <MudTextField @bind-Value="item.Title" Immediate="true" Margin="Margin.Dense" />
                </div>
            </MudTd>
            <MudTd><MudDatePicker @bind-Date="item.StartDate" Editable="true" Margin="Margin.Dense" /></MudTd>
            <MudTd>
                <MudDatePicker @bind-Date="item.EndDate" Editable="true" Margin="Margin.Dense"
                               @bind-Date:after="() => ItemEndDateChanged(item)" />
            </MudTd>
            <MudTd>@ProgressCircle(GetItemProgressPercent(item))</MudTd>
            <MudTd>
                <MudIconButton OnClick="() => DeleteItem(item)" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" />
            </MudTd>
        }
        else if (row.Kind == RowKind.Task)
        {
            var task = row.Task!;
            <MudTd>
                <div class="d-flex align-center" style="padding-left:@(row.Depth * 28)px">
                    <MudIconButton Icon="@ExpandIcon(task)" Size="Size.Small" OnClick="() => Toggle(task)" />
                    <MudCheckBox @bind-Value="task.IsCompleted" @bind-Value:after="() => TaskChecked(task)" Color="Color.Primary" />
                    <MudTextField @bind-Value="task.Title" Immediate="true" Margin="Margin.Dense" />
                </div>
            </MudTd>
            <MudTd><MudDatePicker @bind-Date="task.StartDate" Editable="true" Margin="Margin.Dense" /></MudTd>
            <MudTd>
                <MudDatePicker @bind-Date="task.EndDate" Editable="true" Margin="Margin.Dense"
                               @bind-Date:after="() => TaskEndDateChanged(task)" />
            </MudTd>
            <MudTd>@ProgressCircle(GetTaskProgressPercent(task))</MudTd>
            <MudTd>
                <MudIconButton OnClick="() => DeleteTask(row)" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" />
            </MudTd>
        }
        else // RowKind.Add
        {
            var entry = GetEntry(row.Owner);
            <MudTd>
                <div class="d-flex align-center" style="padding-left:@(row.Depth * 28 + 40)px">
                    <MudTextField Label="@(row.Owner is TrackedItem ? "New task" : "New subtask")"
                                  @bind-Value="entry.Title" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                  OnKeyDown="@(e => AddKeyDown(e, row.Owner))" />
                </div>
            </MudTd>
            <MudTd><MudDatePicker Label="Start Date" @bind-Date="entry.StartDate" Editable="true" Margin="Margin.Dense" /></MudTd>
            <MudTd></MudTd>
            <MudTd></MudTd>
            <MudTd>
                <MudButton OnClick="() => AddChild(row.Owner)" Variant="Variant.Filled" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary">Add</MudButton>
            </MudTd>
        }
    </RowTemplate>
</MudTable>

@code {
    // ---------- row model ----------
    private enum RowKind { Item, Task, Add }

    // Owner: the item/task the row represents (Item/Task rows) or the parent a new child will be added to (Add rows)
    private sealed record TableRow(RowKind Kind, int Depth, TrackedItem Root, ItemTask? Parent, ItemTask? Task, object Owner);

    private sealed class NewEntry
    {
        public string? Title { get; set; }
        public DateTime? StartDate { get; set; } = DateTime.Today;
    }

    // ---------- state ----------
    private string? newItem;
    private DateTime? IstartDate = DateTime.Today;

    private List<TrackedItem> items = [];

    // Reference equality so expand state / entry state is per node
    private readonly HashSet<object> expanded = new(ReferenceEqualityComparer.Instance);
    private readonly Dictionary<object, NewEntry> entries = new(ReferenceEqualityComparer.Instance);

    private NewEntry GetEntry(object owner)
    {
        if (!entries.TryGetValue(owner, out var e))
            entries[owner] = e = new NewEntry();
        return e;
    }

    // ---------- flattening ----------
    private IEnumerable<TableRow> BuildRows()
    {
        foreach (var item in items)
        {
            yield return new TableRow(RowKind.Item, 0, item, null, null, item);

            if (!expanded.Contains(item)) continue;

            foreach (var task in item.Tasks)
                foreach (var r in TaskRows(item, null, task, 1))
                    yield return r;

            yield return new TableRow(RowKind.Add, 1, item, null, null, item);
        }
    }

    private IEnumerable<TableRow> TaskRows(TrackedItem root, ItemTask? parent, ItemTask task, int depth)
    {
        yield return new TableRow(RowKind.Task, depth, root, parent, task, task);

        if (!expanded.Contains(task)) yield break;

        foreach (var sub in task.SubTasks)
            foreach (var r in TaskRows(root, task, sub, depth + 1))
                yield return r;

        yield return new TableRow(RowKind.Add, depth + 1, root, parent, null, task);
    }

    private void Toggle(object node)
    {
        if (!expanded.Remove(node))
            expanded.Add(node);
    }

    private string ExpandIcon(object node) =>
        expanded.Contains(node) ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight;

    private string? RowStyle(TableRow row, int index) =>
        row.Kind == RowKind.Item ? "background: var(--mud-palette-background-gray); font-weight: 500;" : null;

    private RenderFragment ProgressCircle(int percent) => __builder =>
    {
        <MudProgressCircular Rounded="true" Value="percent" Color="GetProgressColor(percent)">
            <ChildContent>
                <span style="font-size: 0.7rem">@percent %</span>
            </ChildContent>
        </MudProgressCircular>
    };

    private Color GetProgressColor(int currentVal) => currentVal switch
    {
        < 30 => Color.Error,
        < 70 => Color.Warning,
        _ => Color.Success
    };

    private static (int completed, int total) CountCompletion(ItemTask task)
    {
        if (task.SubTasks.Count == 0)
            return (task.IsCompleted ? 1 : 0, 1);

        int completed = 0, total = 0;
        foreach (var sub in task.SubTasks)
        {
            var (c, t) = CountCompletion(sub);
            completed += c;
            total += t;
        }
        return (completed, total);
    }

    private static int GetTaskProgressPercent(ItemTask task)
    {
        var (c, t) = CountCompletion(task);
        return t == 0 ? 0 : (int)Math.Round(100.0 * c / t);
    }

    private static int GetItemProgressPercent(TrackedItem item)
    {
        if (item.Tasks.Count == 0)
            return item.IsCompleted ? 100 : 0;

        int completed = 0, total = 0;
        foreach (var task in item.Tasks)
        {
            var (c, t) = CountCompletion(task);
            completed += c;
            total += t;
        }
        return total == 0 ? 0 : (int)Math.Round(100.0 * completed / total);
    }

    private void ProjKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == "NumpadEnter")
            AddItem();
    }

    private void AddKeyDown(KeyboardEventArgs e, object owner)
    {
        if (e.Key == "Enter" || e.Key == "NumpadEnter")
            AddChild(owner);
    }

    private void AddItem()
    {
        if (string.IsNullOrWhiteSpace(newItem)) return;

        items.Add(new TrackedItem { Title = newItem, StartDate = IstartDate });
        newItem = string.Empty;
        IstartDate = DateTime.Today;
    }

    private void AddChild(object owner)
    {
        var entry = GetEntry(owner);
        if (string.IsNullOrWhiteSpace(entry.Title)) return;

        switch (owner)
        {
            case TrackedItem item:
                item.Tasks.Add(new ItemTask { Title = entry.Title, StartDate = entry.StartDate });
                break;
            case ItemTask parent:
                parent.SubTasks.Add(new ItemTask { Title = entry.Title, StartDate = entry.StartDate, ParentId = parent.Id });
                break;
        }

        entry.Title = string.Empty;
        entry.StartDate = DateTime.Today;
        RecomputeAllItems();
    }

    private void DeleteItem(TrackedItem item)
    {
        items.Remove(item);
    }

    private void DeleteTask(TableRow row)
    {
        if (row.Task is null) return;

        if (row.Parent is null)
            row.Root.Tasks.Remove(row.Task);
        else
            row.Parent.SubTasks.Remove(row.Task);

        RecomputeAllItems();
    }

    private void ItemChecked(TrackedItem item)
    {
        if (item.IsCompleted)
            item.EndDate ??= DateTime.Today;
        else
            item.EndDate = null;

        foreach (var task in item.Tasks)
            TaskDates.Apply(task, item.IsCompleted, item.EndDate);
    }

    private void TaskChecked(ItemTask task)
    {
        TaskDates.Apply(task, task.IsCompleted, task.EndDate);
        RecomputeAllItems();
    }

    private void ItemEndDateChanged(TrackedItem item)
    {
        if (item.EndDate is not { } end) return;

        if (end.Date <= DateTime.Today && !item.IsCompleted)
        {
            item.IsCompleted = true;
            ItemChecked(item);
        }
        else if (end.Date > DateTime.Today && item.IsCompleted)
        {
            var picked = item.EndDate;
            item.IsCompleted = false;
            ItemChecked(item);      // uncompletes tasks/subtasks, clears dates
            item.EndDate = picked;  // keep the date the user chose
        }
    }

    private void TaskEndDateChanged(ItemTask task)
    {
        if (task.EndDate is not { } end) return;

        if (end.Date <= DateTime.Today && !task.IsCompleted)
        {
            task.IsCompleted = true;
            TaskChecked(task);
        }
        else if (end.Date > DateTime.Today && task.IsCompleted)
        {
            var picked = task.EndDate;
            TaskDates.Apply(task, false);   // uncompletes this task and its subtasks
            task.EndDate = picked;          // keep the date the user chose
            RecomputeAllItems();
        }
    }

    private void RecomputeAllItems()
    {
        foreach (var item in items)
            RecomputeItem(item);
    }

    private static bool RecomputeTaskStatus(ItemTask task)
    {
        if (task.SubTasks.Count == 0)
            return task.IsCompleted;

        bool allChildrenComplete = true;
        foreach (var sub in task.SubTasks)
        {
            if (!RecomputeTaskStatus(sub))
                allChildrenComplete = false;
        }

        TaskDates.SetDerivedStatus(task, allChildrenComplete, task.SubTasks.Max(s => s.EndDate));
        return allChildrenComplete;
    }

    private static void RecomputeItem(TrackedItem item)
    {
        if (item.Tasks.Count == 0) return;

        bool allComplete = true;
        foreach (var task in item.Tasks)
        {
            if (!RecomputeTaskStatus(task))
                allComplete = false;
        }

        if (item.IsCompleted != allComplete)
        {
            item.IsCompleted = allComplete;
            if (allComplete)
                item.EndDate ??= item.Tasks.Max(t => t.EndDate) ?? DateTime.Today;
            else
                item.EndDate = null;
        }
    }
}