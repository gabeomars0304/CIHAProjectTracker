@page "/"
@rendermode InteractiveServer

<PageTitle>CIHA Item Tracker</PageTitle>

<h3>CIHA Item Tracker</h3>

<MudStack Row="true" AlignItems="AlignItems.Center">
    <MudTextField Label="Item Title" @bind-Value="newItem" Variant="Variant.Outlined" Immediate="true" OnKeyDown="ProjKeyDown" />
    <MudDatePicker Label="Start Date" @bind-Date="PstartDate" Editable="true" />
    <MudButton OnClick="AddItem" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary">Add Item</MudButton>
</MudStack>

<MudExpansionPanels MultiExpansion="true">
    @foreach (var item in items)
    {
        <MudExpansionPanel>
            <TitleContent>
                <MudStack AlignItems="AlignItems.Center" Row="true" @onclick:stopPropagation="true">
                    <MudCheckBox @bind-Value="item.IsCompleted" @bind-Value:after="() => itemChecked(item)" Color="Color.Primary"/>
                    <MudTextField Label="item Title" @bind-Value="item.Title" Variant="Variant.Outlined" Immediate="true"/>
                    <MudDatePicker Label="Start Date" @bind-Date="item.StartDate" Editable="true" />
                    <MudProgressCircular Rounded="true" Value=@GetitemProgressPercent(item)
                        Color=@GetProgressColor(GetitemProgressPercent(item))>
                        <ChildContent>
                            <span style="font-size: 0.7rem">@GetitemProgressPercent(item) %</span>
                        </ChildContent>
                    </MudProgressCircular>
                    <MudIconButton OnClick="() => Deleteitem(item)" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Variant="Variant.Filled"></MudIconButton>
                </MudStack>
            </TitleContent>
            <ChildContent>
                <div class="pa-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudTextField Label="Task Title" @bind-Value="newTask" Variant="Variant.Outlined" Immediate="true"
                            OnKeyDown="@(e => TaskKeyDown(e, item))"/>
                        <MudButton OnClick="() => AddTask(item)" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary">Add Task</MudButton>
                    </MudStack>
                    
                    <MudExpansionPanels MultiExpansion="true" Class="mt-3">
                        @foreach (var task in item.Tasks)
                        {
                            <TaskItem Task="task" OnTreeChanged="RecomputeAllitems" OnDelete="@(t => DeleteRoot(item, t))" />
                        }
                    </MudExpansionPanels>
                </div>
            </ChildContent>
        </MudExpansionPanel>
    }
</MudExpansionPanels>

    @code {
    private string? newItem;
    private string? newTask;
    private DateTime? PstartDate = DateTime.Now;

    private List<TrackedItem> items = [];

    private async Task DeleteRoot(TrackedItem item, ItemTask task)
    {
        item.Tasks.Remove(task);
        RecomputeAllitems();
    }

    private void Deleteitem(TrackedItem item)
    {
        items.Remove(item);
    }

    private void ProjKeyDown(KeyboardEventArgs e)
    {
        if(e.Key == "Enter" || e.Key == "NumpadEnter")
        {
            AddItem();
        }
    }

    private void TaskKeyDown(KeyboardEventArgs e, TrackedItem item)
    {
        if (e.Key == "Enter" || e.Key == "NumpadEnter")
        {
            AddTask(item);
        }
    }

    private void AddItem()
    {
        if (!string.IsNullOrWhiteSpace(newItem))
        {
            items.Add(new TrackedItem { Title = newItem, StartDate = PstartDate });
            newItem = string.Empty;
            PstartDate = DateTime.Now;
        }
    }

    private void AddTask(TrackedItem item)
    {
        if (!string.IsNullOrWhiteSpace(newTask))
        {
            item.Tasks.Add(new ItemTask { Title = newTask });
            newTask = string.Empty;
            RecomputeAllitems();
        }
    }

    private void itemChecked(TrackedItem item)
    {
        foreach (var task in item.Tasks)
        {
            task.IsCompleted = item.IsCompleted;
            CascadeCompleted(task, item.IsCompleted);
        }
    }

    private void RecomputeAllitems()
    {
        foreach (var item in items)
        {
            Recomputeitem(item);
        }
    }

    private static void CascadeCompleted(ItemTask task, bool value)
    {
        foreach (var sub in task.SubTasks)
        {
            sub.IsCompleted = value;
            CascadeCompleted(sub, value);
        }
    }

    private static bool RecomputeTaskStatus(ItemTask task)
    {
        if (task.SubTasks.Count == 0)
        {
            return task.IsCompleted;
        }

        bool allChildrenComplete = true;
        foreach (var sub in task.SubTasks)
        {
            if (!RecomputeTaskStatus(sub))
            {
                allChildrenComplete = false;
            }
        }

        task.IsCompleted = allChildrenComplete;
        return allChildrenComplete;
    }

    private static void Recomputeitem(TrackedItem item)
    {
        if (item.Tasks.Count == 0)
        {
            return;
        }

        bool allComplete = true;
        foreach (var task in item.Tasks)
        {
            if (!RecomputeTaskStatus(task))
            {
                allComplete = false;
            }
        }

        item.IsCompleted = allComplete;
    }

    private static (int completed, int total) CountCompletion(ItemTask task)
    {
        if (task.SubTasks.Count == 0)
        {
            return (task.IsCompleted ? 1 : 0, 1);
        }

        int completed = 0;
        int total = 0;

        foreach (var sub in task.SubTasks)
        {
            var (subCompleted, subTotal) = CountCompletion(sub);
            completed += subCompleted;
            total += subTotal;
        }

        return (completed, total);
    }

    private static int GetitemProgressPercent(TrackedItem item)
    {
        if(item.Tasks.Count == 0)
        {
            return item.IsCompleted ? 100 : 0;
        }

        int completed = 0;
        int total = 0;

        foreach (var task in item.Tasks)
        {
            var (c, t) = CountCompletion(task);
            completed += c;
            total += t;
        }

        return total == 0 ? 0 : (int)Math.Round(100.0 * completed / total);
    }

    private Color GetProgressColor(int currentVal)
    {
        return currentVal switch
        {
            < 30 => Color.Error,
            < 70 => Color.Warning,
            _ => Color.Success
        };
    }
}