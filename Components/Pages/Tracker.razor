@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject IDialogService DialogService
@inject ItemService Service
@inject ChangeNotifier Notifier

<PageTitle>CIHA Item Tracker</PageTitle>

<MudToolBar Dense="true" Class="mb-2">
    <MudButton OnClick="AddItem" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
               Color="Color.Primary">Add Item</MudButton>
</MudToolBar>

<MudDataGrid T="GridRow" Items="rows" Dense="true" Hover="true"
             Breakpoint="Breakpoint.None" RowStyleFunc="RowStyle" RowClick="OnRowClick"
             SortMode="SortMode.None" Filterable="false">
    <Columns>
        <TemplateColumn Title="Title" CellStyle="min-width:200px">
            <CellTemplate>
                @{ var row = context.Item; }
                <div class="d-flex align-center" style="padding-left:@(row.Depth * 28)px">
                    <MudIconButton Icon="@ExpandIcon(row.Owner)" Size="Size.Small" OnClick="() => Toggle(row.Owner)" />
                    <MudIcon Icon="@(IsDone(row) ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.RadioButtonUnchecked)"
                             Color="@(IsDone(row) ? Color.Success : Color.Default)" Size="Size.Small" Class="mx-2" />
                    <MudText>@(row.Kind == RowKind.Item ? row.Root.Title : row.Task!.Title)</MudText>
                </div>
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="Start Date">
            <CellTemplate>
                @{ var row = context.Item; }
                @((row.Kind == RowKind.Item ? row.Root.StartDate : row.Task!.StartDate)?.ToString("d"))
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="End Date">
            <CellTemplate>
                @{ var row = context.Item; }
                @((row.Kind == RowKind.Item ? row.Root.EndDate : row.Task!.EndDate)?.ToString("d"))
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="Progress">
            <CellTemplate>
                @{ var row = context.Item; }
                @ProgressCircle(row.Kind == RowKind.Item
                    ? GetItemProgressPercent(row.Root)
                    : GetTaskProgressPercent(row.Task!))
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="Tag" CellStyle="min-width:170px">
            <CellTemplate>
                @{ var row = context.Item; }
                @foreach (var tag in row.Root.Tags)
                {
                    <MudChip T="ItemTag" Text="@tag.Name" Size="Size.Small" Color="@TagColors.For(tag)"
                             Variant="@(row.Kind == RowKind.Item ? Variant.Filled : Variant.Text)"
                             Style="@(TagColors.Style(tag) + (row.Kind == RowKind.Item ? "" : "opacity:0.6"))" />
                }
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="Global Tracking">
            <CellTemplate>
                @{ var row = context.Item; }
                @if (row.Kind == RowKind.Item && row.Root.IsGloballyTracked)
                {
                    <MudTooltip Text="Globally tracked">
                        <MudIcon Icon="@Icons.Material.Filled.Radar" Color="Color.Success" Size="Size.Small" />
                    </MudTooltip>
                }
                else if (row.Kind == RowKind.Item)
                {
                    <MudTooltip Text="Globally tracked">
                        <MudIcon Icon="@Icons.Material.Filled.Radar" Color="Color.Error" Size="Size.Small" />
                    </MudTooltip>
                }
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="" CellStyle="min-width:140px">
            <CellTemplate>
                @{ var row = context.Item; }
                <MudToolBar Dense="true" Class="pa-0" Style="min-height:unset; background:transparent;">
                    <MudTooltip Text="@(row.Kind == RowKind.Item ? "Add task" : "Add subtask")">
                        <MudIconButton Icon="@Icons.Material.Filled.PlaylistAdd" Color="Color.Primary" Size="Size.Small"
                                       OnClick="() => AddChild(row)" />
                    </MudTooltip>
                    <MudTooltip Text="Delete">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                       OnClick="() => DeleteRow(row)" />
                    </MudTooltip>
                </MudToolBar>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

@code {
    //---------- row model ----------
    private enum RowKind { Item, Task }

    private sealed class GridRow
    {
        public RowKind Kind { get; init; }
        public int Depth { get; init; }
        public TrackedItem Root { get; init; } = default!;
        public ItemTask? Parent { get; init; }
        public ItemTask? Task { get; init; }
        public object Owner { get; init; } = default!;
    }

    //---------- state ----------
    private List<TrackedItem> items = [];
    private List<GridRow> rows = [];
    private List<ItemTag> knownTags = [];
    private bool loading, reloadQueued, disposed;

    //Keyed by ID, not object reference: every reload creates new entity instances.
    private readonly HashSet<string> expanded = [];

    private static string Key(object node) => node switch
    {
        TrackedItem i => $"i{i.Id}",
        ItemTask t => $"t{t.Id}",
        _ => throw new ArgumentException("Unknown node")
    };

    //---------- lifecycle ----------
    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        Notifier.Changed += OnChanged;
    }

    public void Dispose()
    {
        disposed = true;
        Notifier.Changed -= OnChanged;
    }

    //Coalesces bursts: if a reload is running, run exactly one more afterwards.
    private async Task LoadAsync()
    {
        if (loading) { reloadQueued = true; return; }

        loading = true;
        try
        {
            do
            {
                reloadQueued = false;
                (items, knownTags) = await Service.LoadAllAsync();
                Rebuild();
            } while (reloadQueued);
        }
        finally { loading = false; }
    }

    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        if (disposed) return;
        try
        {
            await LoadAsync();
            StateHasChanged();
        }
        catch (Exception) { /* circuit may be gone; ignore */ }
    });

    //---------- flattening ----------
    private void Rebuild() => rows = BuildRows().ToList();

    private IEnumerable<GridRow> BuildRows()
    {
        foreach (var item in items)
        {
            yield return new GridRow { Kind = RowKind.Item, Depth = 0, Root = item, Owner = item };

            if (!expanded.Contains(Key(item))) continue;

            foreach (var task in item.Tasks)
                foreach (var r in TaskRows(item, null, task, 1))
                    yield return r;
        }
    }

    private IEnumerable<GridRow> TaskRows(TrackedItem root, ItemTask? parent, ItemTask task, int depth)
    {
        yield return new GridRow { Kind = RowKind.Task, Depth = depth, Root = root, Parent = parent, Task = task, Owner = task };

        if (!expanded.Contains(Key(task))) yield break;

        foreach (var sub in task.SubTasks)
            foreach (var r in TaskRows(root, task, sub, depth + 1))
                yield return r;
    }

    private void Toggle(object node)
    {
        var key = Key(node);
        if (!expanded.Remove(key))
            expanded.Add(key);
        Rebuild();
    }

    private string ExpandIcon(object node) =>
        expanded.Contains(Key(node)) ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight;

    private static bool IsDone(GridRow row) =>
        row.Kind == RowKind.Item ? row.Root.IsCompleted : row.Task!.IsCompleted;

    private string RowStyle(GridRow row, int index) =>
        "cursor:pointer;" + (row.Kind == RowKind.Item
            ? "background: var(--mud-palette-background-gray); font-weight: 500;" : "");

    //---------- progress ----------
    private RenderFragment ProgressCircle(int percent) => __builder =>
    {
        <MudProgressCircular Rounded="true" Value="percent" Color="GetProgressColor(percent)">
            <ChildContent>
                <span style="font-size: 0.7rem">@percent %</span>
            </ChildContent>
        </MudProgressCircular>
    };

    private Color GetProgressColor(int currentVal) => currentVal switch
    {
        < 30 => Color.Error,
        < 70 => Color.Warning,
        _ => Color.Success
    };

    private static (int completed, int total) CountCompletion(ItemTask task)
    {
        if (task.SubTasks.Count == 0)
            return (task.IsCompleted ? 1 : 0, 1);

        int completed = 0, total = 0;
        foreach (var sub in task.SubTasks)
        {
            var (c, t) = CountCompletion(sub);
            completed += c;
            total += t;
        }
        return (completed, total);
    }

    private static int GetTaskProgressPercent(ItemTask task)
    {
        var (c, t) = CountCompletion(task);
        return t == 0 ? 0 : (int)Math.Round(100.0 * c / t);
    }

    private static int GetItemProgressPercent(TrackedItem item)
    {
        if (item.Tasks.Count == 0)
            return item.IsCompleted ? 100 : 0;

        int completed = 0, total = 0;
        foreach (var task in item.Tasks)
        {
            var (c, t) = CountCompletion(task);
            completed += c;
            total += t;
        }
        return total == 0 ? 0 : (int)Math.Round(100.0 * completed / total);
    }

    //---------- editing ----------
    private Task OnRowClick(DataGridRowClickEventArgs<GridRow> e) => OpenEditor(e.Item);

    private async Task OpenEditor(GridRow row)
    {
        var isItem = row.Kind == RowKind.Item;
        var parameters = new DialogParameters<EditEntryDialog>
        {
            { x => x.IsItem, isItem },
            { x => x.EntryId, isItem ? row.Root.Id : row.Task!.Id },
            { x => x.KnownTags, knownTags }
        };

        //The result isn't needed: a successful save broadcasts and this page reloads.
        await DialogService.ShowAsync<EditEntryDialog>(isItem ? "Edit item" : "Edit task", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true });
    }

    //---------- add / delete ----------
    private async Task<AddEntryDialog.EntryResult?> PromptAsync(string heading, string label, bool showTags = false, bool showGlobalTracking = false)
    {
        var parameters = new DialogParameters<AddEntryDialog>
        {
            { x => x.Label, label },
            { x => x.ShowTags, showTags },
            { x => x.ShowGlobalTracking, showGlobalTracking },
            { x => x.KnownTags, knownTags }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small };

        var dialog = await DialogService.ShowAsync<AddEntryDialog>(heading, parameters, options);
        var result = await dialog.Result;

        return result?.Canceled == false ? result.Data as AddEntryDialog.EntryResult : null;
    }

    private async Task AddItem()
    {
        var entry = await PromptAsync("Add item", "Item title", showTags: true, showGlobalTracking: true);
        if (entry is null) return;

        await Service.AddItemAsync(entry.Title, entry.Description, entry.StartDate,
            entry.Tags.Select(t => t.Name), entry.GlobalTracking);
    }

    private async Task AddChild(GridRow row)
    {
        var isItem = row.Kind == RowKind.Item;
        var entry = await PromptAsync(isItem ? "Add task" : "Add subtask",
                                      isItem ? "Task title" : "Subtask title");
        if (entry is null) return;

        expanded.Add(Key(row.Owner));   //so the new child is visible after the reload
        await Service.AddTaskAsync(isItem ? row.Root.Id : null,
            isItem ? null : row.Task!.Id,
            entry.Title, entry.Description, entry.StartDate);
    }

    private async Task DeleteRow(GridRow row)
    {
        var title = row.Kind == RowKind.Item ? row.Root.Title : row.Task!.Title;
        var yes = await DialogService.ShowMessageBoxAsync("Delete",
            $"Delete \"{title}\" and everything under it?", yesText: "Delete", cancelText: "Cancel");
        if (yes != true) return;

        await Service.DeleteAsync(row.Kind == RowKind.Item,
                                  row.Kind == RowKind.Item ? row.Root.Id : row.Task!.Id);
    }
}