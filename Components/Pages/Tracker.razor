@page "/"
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IDialogService DialogService
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>CIHA Item Tracker</PageTitle>

<MudToolBar Dense="true" Class="mb-2">
    <MudButton OnClick="AddItem" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
               Color="Color.Primary">Add Item</MudButton>
</MudToolBar>

<MudDataGrid T="GridRow" Items="rows" Dense="true" Hover="true"
             Breakpoint="Breakpoint.None" RowStyleFunc="RowStyle"
             SortMode="SortMode.None" Filterable="false">
    <Columns>
        <TemplateColumn Title="Title" Sortable="true" Filterable="false" CellStyle="min-width:380px">
            <CellTemplate>
                @{
                    var row = context.Item;
                }
                @if (row.Kind == RowKind.Item)
                {
                    var item = row.Root;
                    <div class="d-flex align-center">
                        <MudIconButton Icon="@ExpandIcon(item)" Size="Size.Small" OnClick="() => Toggle(item)" />
                        <MudCheckBox @bind-Value="item.IsCompleted" @bind-Value:after="() => ItemChecked(item)" Color="Color.Primary" />
                        <MudTextField @bind-Value="item.Title" Margin="Margin.Dense" />
                    </div>
                }
                else
                {
                    var task = row.Task!;
                    <div class="d-flex align-center" style="padding-left:@(row.Depth * 28)px">
                        <MudIconButton Icon="@ExpandIcon(task)" Size="Size.Small" OnClick="() => Toggle(task)" />
                        <MudCheckBox @bind-Value="task.IsCompleted" @bind-Value:after="() => TaskChecked(task)" Color="Color.Primary" />
                        <MudTextField @bind-Value="task.Title" Margin="Margin.Dense" />
                    </div>
                }
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="Start Date" Sortable="true" Filterable="false">
            <CellTemplate>
                @{
                    var row = context.Item;
                }
                @if (row.Kind == RowKind.Item)
                {
                    <MudDatePicker @bind-Date="row.Root.StartDate" @bind-Date:after="SaveAsync" Editable="true" Margin="Margin.Dense" />
                }
                else
                {
                    <MudDatePicker @bind-Date="row.Task!.StartDate" @bind-Date:after="SaveAsync" Editable="true" Margin="Margin.Dense" />
                }
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="End Date" Sortable="true" Filterable="false">
            <CellTemplate>
                @{
                    var row = context.Item;
                }
                @if (row.Kind == RowKind.Item)
                {
                    var item = row.Root;
                    <MudDatePicker @bind-Date="item.EndDate" Editable="true" Margin="Margin.Dense"
                                   @bind-Date:after="() => ItemEndDateChanged(item)" />
                }
                else
                {
                    var task = row.Task!;
                    <MudDatePicker @bind-Date="task.EndDate" Editable="true" Margin="Margin.Dense"
                                   @bind-Date:after="() => TaskEndDateChanged(task)" />
                }
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="Progress" Sortable="true" Filterable="false">
            <CellTemplate>
                @{
                    var row = context.Item;
                }
                @if (row.Kind == RowKind.Item)
                {
                    @ProgressCircle(GetItemProgressPercent(row.Root))
                }
                else
                {
                    @ProgressCircle(GetTaskProgressPercent(row.Task!))
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Tags" Sortable="true" Filterable="false" CellStyle="min-width:170px">
            <CellTemplate>
                @{
                    var row = context.Item;
                    var item = row.Root;
                }
                    @if (row.Kind == RowKind.Item)
                    {
                        @foreach (var tag in item.Tags)
                        {
                            <MudChip T="ItemTag" Text="@tag.Name" Size="Size.Small"
                                     Color="@TagColors.For(tag)"
                                     OnClose="() => RemoveTag(item, tag)" />
                        }
                    }
                    else
                    {
                        @foreach (var tag in item.Tags)
                        {
                            <MudChip T="ItemTag" Text="@tag.Name" Size="Size.Small"
                                     Color="@TagColors.For(tag)" Variant="Variant.Text" Style="opacity:0.6" />
                        }
                    }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="" Sortable="false" Filterable="false" CellStyle="min-width:140px">
            <CellTemplate>
                @{
                    var row = context.Item;
                }
                <MudToolBar Dense="true" Class="pa-0" Style="min-height:unset; background:transparent;">
                    @if(row.Kind == RowKind.Task)
                    {
                        <span style="display:inline-block; width:75px"></span>
                    }
                    @if (row.Kind == RowKind.Item)
                    {
                        <MudTooltip Text="@(row.Root.IsGloballyTracked ? "Stop global tracking" : "Track globally")">
                            <MudToggleIconButton Toggled="row.Root.IsGloballyTracked"
                                                 ToggledChanged="(bool on) => SetGlobalTracking(row.Root, on)"
                                                 Icon="@Icons.Material.Outlined.Radar"
                                                 Color="@Color.Error"
                                                 ToggledIcon="@Icons.Material.Filled.Radar"
                                                 ToggledColor="@Color.Success" />
                        </MudTooltip>
                        <MudTooltip Text="Edit tags">
                            <MudIconButton Icon="@Icons.Material.Filled.Label" Size="Size.Small"
                                           OnClick="() => EditTags(row.Root)" />
                        </MudTooltip>
                    }
                    <MudTooltip Text="@(row.Kind == RowKind.Item ? "Add task" : "Add subtask")">
                        <MudIconButton Icon="@Icons.Material.Filled.PlaylistAdd" Color="Color.Primary" Size="Size.Small"
                                       OnClick="() => AddChild(row.Owner)" />
                    </MudTooltip>
                    <MudTooltip Text="Delete">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                       OnClick="() => DeleteRow(row)" />
                    </MudTooltip>
                </MudToolBar>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

@code {
    // ---------- row model ----------
    private enum RowKind { Item, Task }
    // Owner: the item/task the row represents (Item/Task rows) or the parent a new child is added to (Add rows)
    private sealed class GridRow
    {
        public RowKind Kind { get; init; }
        public int Depth { get; init; }
        public TrackedItem Root { get; init; } = default!;
        public ItemTask? Parent { get; init; }
        public ItemTask? Task { get; init; }
        public object Owner { get; init; } = default!;
    }

    // ---------- state ----------
    private AppDbContext db = default!;
    private readonly SemaphoreSlim saveLock = new(1, 1);

    private List<TrackedItem> items = [];
    private List<GridRow> rows = [];
    private List<ItemTag> knownTags = [];
    private readonly HashSet<object> expanded = new(ReferenceEqualityComparer.Instance);

    protected override async Task OnInitializedAsync()
    {
        // One context for the lifetime of this component; entities stay tracked,
        // so edits made through the bindings are picked up by SaveChanges.
        db = await DbFactory.CreateDbContextAsync();

        knownTags = await db.Tags.OrderBy(t => t.Name).ToListAsync();
        items = await db.Items.Include(i => i.Tags).OrderBy(i => i.Id).ToListAsync();

        // Loading every task makes EF's relationship fix-up populate
        // Item.Tasks and Task.SubTasks at every depth (no recursive Include needed).
        await db.Tasks.OrderBy(t => t.Id).ToListAsync();

        Rebuild();
    }

    public ValueTask DisposeAsync() => db is null ? ValueTask.CompletedTask : db.DisposeAsync();

    // Serialised: DbContext isn't thread-safe and Blazor can overlap event handlers.
    private async Task SaveAsync()
    {
        await saveLock.WaitAsync();
        try { await db.SaveChangesAsync(); }
        finally { saveLock.Release(); }
    }

    // ---------- flattening ----------
    // Rows are cached and only rebuilt when the structure changes (expand/collapse, add, delete),
    // so typing in a cell doesn't cause the grid to receive a brand-new list on every keystroke.
    private void Rebuild() => rows = BuildRows().ToList();

    private IEnumerable<GridRow> BuildRows()
    {
        foreach (var item in items)
        {
            yield return new GridRow { Kind = RowKind.Item, Depth = 0, Root = item, Owner = item };

            if (!expanded.Contains(item)) continue;

            foreach (var task in item.Tasks)
                foreach (var r in TaskRows(item, null, task, 1))
                    yield return r;
        }
    }

    private IEnumerable<GridRow> TaskRows(TrackedItem root, ItemTask? parent, ItemTask task, int depth)
    {
        yield return new GridRow { Kind = RowKind.Task, Depth = depth, Root = root, Parent = parent, Task = task, Owner = task };

        if (!expanded.Contains(task)) yield break;

        foreach (var sub in task.SubTasks)
            foreach (var r in TaskRows(root, task, sub, depth + 1))
                yield return r;
    }

    private void Toggle(object node)
    {
        if (!expanded.Remove(node))
            expanded.Add(node);
        Rebuild();
    }

    private string ExpandIcon(object node) =>
        expanded.Contains(node) ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight;

    private string RowStyle(GridRow row, int index) =>
        row.Kind == RowKind.Item ? "background: var(--mud-palette-background-gray); font-weight: 500;" : "";

    // ---------- progress ----------
    private RenderFragment ProgressCircle(int percent) => __builder =>
    {
        <MudProgressCircular Rounded="true" Value="percent" Color="GetProgressColor(percent)">
            <ChildContent>
                <span style="font-size: 0.7rem">@percent %</span>
            </ChildContent>
        </MudProgressCircular>
    };

    private Color GetProgressColor(int currentVal) => currentVal switch
    {
        < 30 => Color.Error,
        < 70 => Color.Warning,
        _ => Color.Success
    };

    private static (int completed, int total) CountCompletion(ItemTask task)
    {
        if (task.SubTasks.Count == 0)
            return (task.IsCompleted ? 1 : 0, 1);

        int completed = 0, total = 0;
        foreach (var sub in task.SubTasks)
        {
            var (c, t) = CountCompletion(sub);
            completed += c;
            total += t;
        }
        return (completed, total);
    }

    private static int GetTaskProgressPercent(ItemTask task)
    {
        var (c, t) = CountCompletion(task);
        return t == 0 ? 0 : (int)Math.Round(100.0 * c / t);
    }

    private static int GetItemProgressPercent(TrackedItem item)
    {
        if (item.Tasks.Count == 0)
            return item.IsCompleted ? 100 : 0;

        int completed = 0, total = 0;
        foreach (var task in item.Tasks)
        {
            var (c, t) = CountCompletion(task);
            completed += c;
            total += t;
        }
        return total == 0 ? 0 : (int)Math.Round(100.0 * completed / total);
    }

    // ---------- add / delete ----------

    private async Task DeleteItem(TrackedItem item)
    {
        items.Remove(item);
        db.Items.Remove(item);   // tasks cascade in the DB, subtasks via ClientCascade
        await SaveAsync();
        Rebuild();
    }

    private async Task DeleteTask(GridRow row)
    {
        if (row.Task is null) return;

        if (row.Parent is null)
            row.Root.Tasks.Remove(row.Task);
        else
            row.Parent.SubTasks.Remove(row.Task);

        db.Tasks.Remove(row.Task);   // removing from the collection alone would only orphan it

        RecomputeAllItems();
        await SaveAsync();
        Rebuild();
    }

    // ---------- completion / dates ----------
    private void ApplyItemChecked(TrackedItem item)
    {
        if (item.IsCompleted)
            item.EndDate ??= DateTime.Today;
        else
            item.EndDate = null;

        foreach (var task in item.Tasks)
            TaskDates.Apply(task, item.IsCompleted, item.EndDate);
    }

    private async Task ItemChecked(TrackedItem item)
    {
        ApplyItemChecked(item);
        await SaveAsync();
    }

    private void ApplyTaskChecked(ItemTask task)
    {
        TaskDates.Apply(task, task.IsCompleted, task.EndDate);
        RecomputeAllItems();
    }

    private async Task TaskChecked(ItemTask task)
    {
        ApplyTaskChecked(task);
        await SaveAsync();
    }

    private async Task ItemEndDateChanged(TrackedItem item)
    {
        if (item.EndDate is { } end)
        {
            if (end.Date <= DateTime.Today && !item.IsCompleted)
            {
                item.IsCompleted = true;
                ApplyItemChecked(item);
            }
            else if (end.Date > DateTime.Today && item.IsCompleted)
            {
                var picked = item.EndDate;
                item.IsCompleted = false;
                ApplyItemChecked(item);   // uncompletes tasks/subtasks, clears dates
                item.EndDate = picked;    // keep the date the user chose
            }
        }
        await SaveAsync();
    }

    private async Task TaskEndDateChanged(ItemTask task)
    {
        if (task.EndDate is { } end)
        {
            if (end.Date <= DateTime.Today && !task.IsCompleted)
            {
                task.IsCompleted = true;
                ApplyTaskChecked(task);
            }
            else if (end.Date > DateTime.Today && task.IsCompleted)
            {
                var picked = task.EndDate;
                TaskDates.Apply(task, false);
                task.EndDate = picked;
                RecomputeAllItems();
            }
        }
        await SaveAsync();
    }

    private void RecomputeAllItems()
    {
        foreach (var item in items)
            RecomputeItem(item);
    }

    private static bool RecomputeTaskStatus(ItemTask task)
    {
        if (task.SubTasks.Count == 0)
            return task.IsCompleted;

        bool allChildrenComplete = true;
        foreach (var sub in task.SubTasks)
        {
            if (!RecomputeTaskStatus(sub))
                allChildrenComplete = false;
        }

        TaskDates.SetDerivedStatus(task, allChildrenComplete, task.SubTasks.Max(s => s.EndDate));
        return allChildrenComplete;
    }

    private static void RecomputeItem(TrackedItem item)
    {
        if (item.Tasks.Count == 0) return;

        bool allComplete = true;
        foreach (var task in item.Tasks)
        {
            if (!RecomputeTaskStatus(task))
                allComplete = false;
        }

        if (item.IsCompleted != allComplete)
        {
            item.IsCompleted = allComplete;
            if (allComplete)
                item.EndDate ??= item.Tasks.Max(t => t.EndDate) ?? DateTime.Today;
            else
                item.EndDate = null;
        }
    }

    private async Task DeleteRow(GridRow row)
    {
        if (row.Kind == RowKind.Item)
            await DeleteItem(row.Root);
        else
            await DeleteTask(row);
    }

    private async Task<AddEntryDialog.EntryResult?> PromptAsync(string heading, string label, bool showTags = false, bool showGlobalTracking = false)
    {
        var parameters = new DialogParameters<AddEntryDialog>
        {
            { x => x.Label, label },
            { x => x.ShowTags, showTags },
            { x => x.ShowGlobalTracking, showGlobalTracking },
            { x => x.KnownTags, knownTags }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small };

        var dialog = await DialogService.ShowAsync<AddEntryDialog>(heading, parameters, options);
        var result = await dialog.Result;

        return result?.Canceled == false ? result.Data as AddEntryDialog.EntryResult : null;
    }

    private async Task AddItem()
    {
        var entry = await PromptAsync("Add item", "Item title", showTags: true, showGlobalTracking: true);
        if (entry is null) return;

        RegisterTags(entry.Tags);
        var item = new TrackedItem
        {
            Title = entry.Title,
            StartDate = entry.StartDate,
            Tags = entry.Tags,
            IsGloballyTracked = entry.GlobalTracking
        };

        items.Add(item);
        db.Items.Add(item);
        await SaveAsync();
        Rebuild();
    }

    private async Task AddChild(object owner)
    {
        var isItem = owner is TrackedItem;
        var entry = await PromptAsync(isItem ? "Add task" : "Add subtask",
                                      isItem ? "Task title" : "Subtask title");
        if (entry is null) return;

        RegisterTags(entry.Tags);
        switch (owner)
        {
            case TrackedItem item:
                item.Tasks.Add(new ItemTask { Title = entry.Title, StartDate = entry.StartDate });
                break;
            case ItemTask parent:
                // EF sets ParentId from the collection; no need to assign it by hand
                parent.SubTasks.Add(new ItemTask { Title = entry.Title, StartDate = entry.StartDate });
                break;
        }

        expanded.Add(owner);
        RecomputeAllItems();
        await SaveAsync();
        Rebuild();
    }

    // Adds any newly created tags to the catalog (by name, case-insensitive)
    private void RegisterTags(IEnumerable<ItemTag> tags)
    {
        foreach (var t in tags)
        {
            if (knownTags.Any(k => string.Equals(k.Name, t.Name, StringComparison.OrdinalIgnoreCase)))
                continue;

            knownTags.Add(t);
            db.Tags.Add(t);
        }
    }

    private async Task EditTags(TrackedItem item)
    {
        var parameters = new DialogParameters<AddTagDialog>
        {
            { x => x.ExistingTags, knownTags },
            { x => x.InitiallySelected, item.Tags }
        };

        var dialog = await DialogService.ShowAsync<AddTagDialog>("Tags", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: AddTagDialog.TagPickerResult r })
        {
            RegisterTags(r.Created);
            item.Tags.Clear();               // mutate the tracked collection instead of replacing it
            item.Tags.AddRange(r.Selected);
            await SaveAsync();
            Rebuild();
        }
    }

    private async Task RemoveTag(TrackedItem item, ItemTag tag)
    {
        item.Tags.Remove(tag);
        await SaveAsync();
    }

    private async Task SetGlobalTracking(TrackedItem item, bool on)
    {
        item.IsGloballyTracked = on;
        await SaveAsync();
    }
}